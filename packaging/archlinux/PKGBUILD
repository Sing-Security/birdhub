# Maintainer: LFAM Orbit <admin@lfam.us>
pkgname=birdhub
pkgver=0.1.0
pkgrel=1
pkgdesc="Relay over Temper certificates: hub and client in one binary"
arch=('x86_64' 'aarch64')
url="https://github.com/your-org/birdhub"
license=('custom:Proprietary')
# No runtime dependencies: the tunnel is an ordinary TCP connection. The
# netbird/nftables/iproute2 dependencies of the first packaging are gone
# along with the code that needed them.
depends=()
makedepends=('cargo')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/your-org/birdhub/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP') # Replace with actual checksum when publishing

build() {
  cd "${pkgname}-${pkgver}"
  export CARGO_TARGET_DIR=target
  cargo build --release --locked
}

check() {
  cd "${pkgname}-${pkgver}"
  export CARGO_TARGET_DIR=target
  cargo test --release --locked
}

package() {
  cd "${pkgname}-${pkgver}"

  install -Dm755 "target/release/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"

  # Both role configs. They reference /etc/birdhub/keys/ for the identity,
  # certificate and CA files, which enrollment creates; see the header of
  # each file for the three commands that produce them.
  install -Dm644 hub-config.toml "${pkgdir}/etc/${pkgname}/hub-config.toml"
  install -Dm644 client-config.toml "${pkgdir}/etc/${pkgname}/client-config.toml"

  install -Dm644 "packaging/${pkgname}.service" "${pkgdir}/usr/lib/systemd/system/${pkgname}.service"
  install -Dm644 "packaging/${pkgname}.sysusers" "${pkgdir}/usr/lib/sysusers.d/${pkgname}.conf"

  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
